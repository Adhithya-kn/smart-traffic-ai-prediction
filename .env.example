# ==============================================================================
# Smart Traffic AI: Environment Configuration Template
# Copy this file to .env and configure actual production values.
# IMPORTANT: Never commit .env or actual secret credentials to source control.
# ==============================================================================

# Runtime Environment & Server Binding
ENV=development
PORT=8000
PERSISTENT_DATA_DIR=

# External API Credentials
# ------------------------------------------------------------------------------
# TomTom API Key: Required for real-time flowSegmentData, incidentDetails, and calculateRoute.
# Kept strictly on the backend; never exposed to browser clients.
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com
TOMTOM_TIMEOUT_SECONDS=6.0

# Google Maps API Key: Browser-facing key restricted to authorized domains and APIs.
# Restrict this key in Google Cloud Console to: Maps JavaScript API, Places API, Routes API.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com
GOOGLE_MAPS_TIMEOUT_SECONDS=6.0

# Weather API (Open-Meteo is free; custom commercial key optional)
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=6.0

# Cache & Polling Configuration
API_CACHE_TTL_SECONDS=60.0
API_MAX_RETRIES=3

# Ingestion & Video Upload Sizing (256 MB max, 8 MB chunks)
MAX_REQUEST_BODY_SIZE=10485760
MAX_VIDEO_UPLOAD_SIZE=268435456
CHUNK_UPLOAD_SIZE=8388608

# Security & Authentication
ADMIN_USERNAME=traffic_admin
ADMIN_PASSWORD=
ALLOW_DEMO_ACCOUNTS=true
ENFORCE_ADMIN_AUTH=false
SESSION_TTL_SECONDS=86400
CORS_ALLOWED_ORIGINS=*

# Cryptographic Master Secrets (Random hex strings generated in production)
SECRET_KEY=
JWT_SECRET=
SECRETS_VAULT_KEY=
