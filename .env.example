# ==============================================================================
# Smart Traffic AI: Central Environment Configuration Template
# Copy this file to .env and configure actual production values.
# IMPORTANT: Never commit .env or actual secret credentials to source control.
# ==============================================================================

# MAP SERVICES
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=

# LIVE TRAFFIC
TOMTOM_API_KEY=

# WEATHER (Open-Meteo is public; key is optional)
WEATHER_API_KEY=

# APPLICATION SECURITY & SESSION SIGNING
APP_SECRET_KEY=
SESSION_SECRET_KEY=

# SECRETS MANAGEMENT VAULT
VAULT_MASTER_KEY=

# APPLICATION ENVIRONMENT
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8081

# DATA STORAGE (e.g. /var/data for Render Persistent Disk)
PERSISTENT_DATA_DIR=

# UPLOAD SIZING & LIMITS (256 MB max, 8 MB chunks)
MAX_VIDEO_UPLOAD_SIZE=268435456
CHUNK_UPLOAD_SIZE=8388608

# AUTHENTICATION & ACCESS CONTROL
ADMIN_USERNAME=traffic_admin
ADMIN_PASSWORD=
ALLOW_DEMO_ACCOUNTS=true
ENFORCE_ADMIN_AUTH=false
SESSION_TTL_SECONDS=86400
CORS_ALLOWED_ORIGINS=*
