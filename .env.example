# ==============================================================================
# Smart Traffic AI: Environment Configuration Template
# Copy to .env and set real values. Never commit .env or secrets.
# ==============================================================================

# MAP SERVICES (browser key is delivered to the client; restrict it by referrer)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com

# LIVE TRAFFIC (server-side only)
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com

# WEATHER (Open-Meteo is public and keyless)
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# APPLICATION SECURITY & SESSION SIGNING
APP_SECRET_KEY=
SESSION_SECRET_KEY=

# SECRETS MANAGEMENT VAULT
VAULT_MASTER_KEY=

# APPLICATION ENVIRONMENT
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8090

# DATA STORAGE
# PERSISTENT_DATA_DIR is for a mounted disk (e.g. Render /var/data).
# RUNTIME_DATA_DIR defaults to ./var locally and <PERSISTENT_DATA_DIR>/runtime
# on a mounted disk; it holds mutable users/events/jobs, never tracked artifacts.
PERSISTENT_DATA_DIR=
# RUNTIME_DATA_DIR=

# UPLOAD SIZING & LIMITS (256 MB max, 8 MB chunks)
MAX_VIDEO_UPLOAD_SIZE=268435456
CHUNK_UPLOAD_SIZE=8388608

# AUTHENTICATION & ACCESS CONTROL
ADMIN_USERNAME=traffic_admin
ADMIN_PASSWORD=
ALLOW_DEMO_ACCOUNTS=true
ENFORCE_ADMIN_AUTH=true
ALLOW_ANONYMOUS_ADMIN=false
SESSION_TTL_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
