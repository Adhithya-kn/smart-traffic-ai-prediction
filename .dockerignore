# Version Control & Git
.git
.gitignore
.dockerignore

# Python Caches & Bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Operating System Files
.DS_Store
.AppleDouble
.Spotlight-V100
.Trashes

# Virtual Environments
.venv/
venv/
env/
ENV/

# Development, IDE & Agent Metadata
.agents/
.system_generated/
.claude/
.idea/
.vscode/
node_modules/
tests/
docs/
scripts/
prework-research/
*.log
*.tmp

# Credentials & Runtime State
var/
traffic_system/artifacts/.secrets.vault
traffic_system/artifacts/sessions.json
traffic_system/artifacts/backups/*.json
*.vault
.env
.env.*

# Generated Videos & Transients
traffic_system/storage/videos/uploads/*
!traffic_system/storage/videos/uploads/.gitkeep
traffic_system/storage/videos/raw/*
!traffic_system/storage/videos/raw/.gitkeep
traffic_system/storage/videos/processed/*
!traffic_system/storage/videos/processed/.gitkeep
traffic_system/storage/videos/temp/*
!traffic_system/storage/videos/temp/.gitkeep

# Runtime output datasets
Dataset/traffic_prediction_results.csv
Dataset/congestion_comparison.csv

# Large local media fixtures, research archives, and CI configuration (not needed at runtime)
Dataset/*.mp4
Literature/
.github/

# Mutable runtime state written by dev/live servers (never bake into the image).
# Seed data for deployment lives in tracked files (artifacts/seeds, tests/fixtures).
traffic_system/artifacts/users.json
traffic_system/artifacts/events.json
traffic_system/artifacts/vision_jobs.json
traffic_system/artifacts/sessions.json
traffic_system/artifacts/incident_history.json
traffic_system/storage/videos/chunks/*

# Not needed by the Python container runtime: Vercel/static mirror, CV eval data, CI config
public/
data/
.github/
